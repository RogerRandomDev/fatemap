[sub_resource type="GDScript" id="GDScript_aglai"]
script/source = "extends VBoxContainer

var launchData:Dictionary={}

func _ready() -> void:
	if FileAccess.file_exists(\"user://Launch.dat\"):
		var f=FileAccess.open(\"user://Launch.dat\",FileAccess.READ)
		launchData = f.get_var(true)
		f.close()
	
	var base:VBoxContainer=GUIService.insertElement(
		GUIService.createElement(
			self,
			&\"LaunchInterfaceBase\",
			[&\"LaunchInterface\"],null
		)
	).reference
	base.size_flags_horizontal=Control.SIZE_EXPAND_FILL
	base.size_flags_vertical=Control.SIZE_EXPAND_FILL

func storeLaunch()->void:
	var f=FileAccess.open(\"user://Launch.dat\",FileAccess.WRITE)
	f.store_var(launchData,true)
	f.close()

func _exit_tree() -> void:
	storeLaunch()
"


[gd_scene format=3 uid="uid://bc45ojtp3iis7"]

[sub_resource type="GDScript" id="GDScript_prho5"]
script/source = "extends FileDialog


func _ready() -> void:
	canceled.connect(file_selected.emit.bind(\"\"))
	root_subfolder=ProjectSettings.get_setting(\"fatemap/project_directory\",\"res://\")
	

func selectFile(item:TreeItem)->String:
	popup()
	var _context=item.get_meta(\"context\")
	
	var selected=await file_selected
	selected = selected.replace(root_subfolder,\"res://\")
	
	return selected
	
"

[node name="FileParameterPopup" type="FileDialog" unique_id=574229269]
title = "Open a File"
initial_position = 4
